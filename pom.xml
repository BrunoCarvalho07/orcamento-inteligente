<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        O parent do Spring Boot fixa as versões de todas as bibliotecas "oficiais" (Hibernate, Jackson,
        Lombok, JUnit...). Assim evitamos o clássico problema de versões incompatíveis entre si.

        Spring AI 2.0.x suporta Spring Boot 4.0.x e 4.1.x (Spring Framework 7). Usamos a 4.1.x, a linha
        estável mais recente no momento em que este projeto foi escrito.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.orcamentoia</groupId>
    <artifactId>orcamento-inteligente</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>orcamento-inteligente</name>
    <description>API de orçamento financeiro controlada por voz, com Spring AI (Tool Calling, STT e TTS)</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>2.0.2</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                O BOM do Spring AI alinha as versões de todos os módulos spring-ai-*. Por isso os starters
                abaixo não precisam declarar versão.
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- API REST (Spring MVC). No Spring Boot 4 o starter web MVC se chama "webmvc". -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Bean Validation (jakarta.validation) para validar os DTOs de entrada. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Persistência com Spring Data JPA + Hibernate. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Spring AI + OpenAI. Um único starter traz tudo o que precisamos:
              - ChatModel / ChatClient (conversa e Tool Calling)
              - OpenAiAudioTranscriptionModel (Speech-to-Text)
              - TextToSpeechModel (Text-to-Speech)
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Banco em memória para desenvolvimento: sobe sem instalar nada. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Driver do PostgreSQL, usado quando o perfil "postgres" está ativo. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Lombok com moderação: usamos apenas @Getter, @ToString, @Slf4j, @RequiredArgsConstructor e,
            nas entidades JPA, @Getter/@Setter/@NoArgsConstructor. Evitamos @Data (principalmente em
            entidades) porque equals/hashCode/toString gerados automaticamente causam problemas com
            proxies lazy do Hibernate e deixam o contrato das classes de domínio pouco explícito.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                A partir do JDK 23 o javac não executa mais annotation processors "implicitamente" a partir do
                classpath. Declarar o Lombok aqui garante que o projeto compile em qualquer JDK 17+.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok só é necessário em tempo de compilação; não vai para o JAR final. -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
